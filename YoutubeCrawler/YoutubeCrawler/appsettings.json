{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/youtube-crawler-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "CrawlerConfig": {
    "ApiKey": "YOUR_YOUTUBE_API_KEY",
    "ConnectionString": "Server=localhost;Database=YoutubeData;Trusted_Connection=True;TrustServerCertificate=True;",
    "LogPath": "Logs/youtube-crawler-.log",
    "MaxRetryCount": 5,
    "SyncIntervalSeconds": 86400,
    "BatchSize": 50
  },
  "TargetChannels": [
    "https://www.youtube.com/@GoogleDevelopers",
    "https://www.youtube.com/@MrBeast"
  ]
}
